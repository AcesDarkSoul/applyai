# Firebase Configuration (client-side, safe to expose)
# Get from: Firebase Console > Project Settings > Web App
# Current project: petcare-9f4e6
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=petcare-9f4e6.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=petcare-9f4e6
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=petcare-9f4e6.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=your_android_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
# Required for Google Sign-In on Android/iOS (web uses Firebase popup)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ===== Cloud Functions Environment Variables =====
# These are set via: firebase functions:config:set or firebase functions:secrets:set
# They are NOT used by the client app — only by Cloud Functions server-side.
#
# OpenAI API Key (for resume parsing + cover letters + email generation)
#   firebase functions:secrets:set OPENAI_API_KEY
#
# RapidAPI Key (for JSearch job listings)
#   firebase functions:secrets:set RAPIDAPI_KEY
#
# SendGrid API Key (for recruiter outreach emails)
#   firebase functions:secrets:set SENDGRID_API_KEY
#
# From Email (for SendGrid)
#   firebase functions:secrets:set FROM_EMAIL
