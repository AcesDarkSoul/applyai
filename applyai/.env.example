# Firebase Configuration (client-side, safe to expose)
# Get from: Firebase Console > Project Settings > Web App
# Current project: petcare-9f4e6
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=petcare-9f4e6.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=petcare-9f4e6
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=petcare-9f4e6.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=985875105334
EXPO_PUBLIC_FIREBASE_APP_ID=your_web_app_id
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=1:985875105334:android:1325655c15546ed833fa97
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Analytics (GA4) needs MEASUREMENT_ID from Firebase Console → Project settings → Your apps.
# Crashlytics: enable in Firebase Console → Crashlytics (Android/iOS apps). Rebuild native app after install.

# Backend API — MUST be reachable from the phone (not localhost).
# Firebase (production): https://petcare-9f4e6.web.app/api/v1
# Physical device + USB adb reverse: http://127.0.0.1:4000/api/v1
# Android emulator: http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=https://petcare-9f4e6.web.app/api/v1

# Google Sign-In — from google-services.json oauth_client
# client_type 3 (Web) — required for Firebase ID token
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=985875105334-aqp4pmkrjv5b0t301vunurvp9n4ot36q.apps.googleusercontent.com
# client_type 1 (Android) — required for Play/device Google sign-in (reverse-client-id redirect)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=985875105334-3127musg7kpivsd0kjhnikb9v1qs2okv.apps.googleusercontent.com
