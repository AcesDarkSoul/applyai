{
  "expo": {
    "name": "ApplyAI",
    "slug": "applyai",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "applyai",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/android-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C18"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.applyai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C18",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.applyai.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "com.googleusercontent.apps.985875105334-3127musg7kpivsd0kjhnikb9v1qs2okv",
              "path": "/oauthredirect"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0C18"
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true
          }
        }
      ],
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBCrashlytics"
            ]
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
