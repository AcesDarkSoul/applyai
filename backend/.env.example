NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8081,http://127.0.0.1:8081

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: path to service account JSON instead of split vars
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Job search (RapidAPI JSearch — optional fallback)
RAPIDAPI_KEY=
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com

# Apify + SerpApi (primary live pipeline — same as n8n)
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=curious_coder/linkedin-jobs-scraper
APIFY_INDEED_ACTOR_ID=misceres/indeed-scraper
SERPAPI_API_KEY=
JOB_SEARCH_QUERY=Full Stack Developer
JOB_SEARCH_LOCATION=India
JOB_SEARCH_LIMIT=15
JOB_SCRAPE_SOURCES=serpapi,indeed
PREFER_LIVE_CATALOG=true
INGEST_API_KEY=applyai-local-ingest

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AI_RATE_LIMIT_MAX=30

# Demo mode: allows demo-* JWT without Firebase Auth. Persistence still uses
# Firestore when FIREBASE_* credentials are set; otherwise a local file mirror.
DEMO_MODE=true

# Outreach — background send FROM YOUR accounts (no app open)
# Gmail App Password: https://myaccount.google.com/apppasswords
USER_SMTP_HOST=smtp.gmail.com
USER_SMTP_PORT=587
USER_SMTP_SECURE=false
USER_SMTP_USER=
USER_SMTP_PASS=
# Meta WhatsApp Cloud API (your WhatsApp Business number) — silent background send
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional fallbacks (not your personal mailbox / chat)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Global dry-run; enable Auto-send in AI Tools to override per user
OUTREACH_DRY_RUN=true

# Daily job fetch + auto-apply (runs inside the API process)
DAILY_AUTOMATION_ENABLED=true
# Cron: minute hour day month weekday — 8:00 AM India time
DAILY_AUTOMATION_CRON=0 8 * * *
DAILY_AUTOMATION_TZ=Asia/Kolkata
# Also run once shortly after API boot (handy for local testing)
DAILY_AUTOMATION_RUN_ON_START=true
DAILY_AUTOMATION_STARTUP_DELAY_MS=12000
DAILY_AUTO_APPLY_LIMIT=8
DAILY_AUTO_APPLY_MIN_SCORE=55

# Razorpay (Dashboard → Account & Settings → API Keys)
# Key Id is public (also sent to the app). Key Secret stays on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → create endpoint https://YOUR_API/api/v1/billing/razorpay/webhook
# Events: payment.captured
RAZORPAY_WEBHOOK_SECRET=
