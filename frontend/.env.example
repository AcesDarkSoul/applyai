VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEMO_MODE=true

# Firebase web config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Analytics (GA4) — set MEASUREMENT_ID from Firebase Console → Project settings → Web app.
# Crashlytics is mobile-only; web errors are logged as Analytics "exception" events.

# Google Identity / Firebase Google provider (oauth client_type 3)
VITE_GOOGLE_CLIENT_ID=
