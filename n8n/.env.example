# n8n core
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace-with-long-random-string
GENERIC_TIMEZONE=Asia/Kolkata

# Auth for n8n UI (change in production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Job discovery (RapidAPI JSearch — same source as ApplyAI)
RAPIDAPI_KEY=your_rapidapi_key
JSEARCH_QUERY=Full Stack Developer India
JSEARCH_PAGES=1
JSEARCH_COUNTRY=in
# Comma list: linkedin,indeed,naukri,glassdoor,other  OR  all
PLATFORM_FILTER=linkedin,indeed,naukri,other

# --- Optional: Apify + SerpApi multi-source scrapers (Code node: normalizeJobs) ---
# Apify Console → Settings → Integrations → API token
APIFY_TOKEN=apify_api_xxxxxxxx
# Actor IDs (examples — replace with the actors you use)
APIFY_LINKEDIN_ACTOR_ID=curious_coder/linkedin-jobs-scraper
APIFY_INDEED_ACTOR_ID=misceres/indeed-scraper
# SerpApi → https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key
# Shared search query for LinkedIn / Indeed / Google Jobs actors
JOB_SEARCH_QUERY=Full Stack Developer
JOB_SEARCH_LOCATION=India
JOB_SEARCH_LIMIT=25

# Push normalized jobs into ApplyAI API (local backend)
APPLYAI_API_BASE=http://localhost:4000/api/v1
INGEST_API_KEY=applyai-local-ingest

# Optional: path to resume PDF/TXT (or drop file in config/resumes/)
RESUME_PATH=
# Optional: OpenAI key for high-quality resume parsing (falls back to heuristic)
OPENAI_API_KEY=

# Email mode:
#   device   = open mail app on your device (From = your login email) ← recommended
#   sendgrid = server API send (From must be verified in SendGrid)
OUTREACH_EMAIL_MODE=device

# Candidate profile (auto-filled by: npm run sync:resume -- path\to\resume.pdf)
# Set CANDIDATE_EMAIL to the same email you use to log in to ApplyAI
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=you@example.com
CANDIDATE_PHONE=+91XXXXXXXXXX
CANDIDATE_SKILLS=React,TypeScript,Node.js,Firebase
CANDIDATE_TITLE=Full Stack Developer
CANDIDATE_LOCATION=Remote
CANDIDATE_RESUME_URL=https://example.com/resume.pdf
CANDIDATE_YEARS_EXP=3

# Outreach limits (compliance)
DAILY_EMAIL_LIMIT=10
DAILY_SMS_LIMIT=5
MIN_MATCH_SCORE=50

# SendGrid only if OUTREACH_EMAIL_MODE=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@applyai.app

# SMS / WhatsApp via Twilio — leave blank to log-only when phone found
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_MODE=sms

# Dry run: true = extract + log only, do not open mail / send
OUTREACH_DRY_RUN=true
